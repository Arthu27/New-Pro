# ProBotum Configuration
# =====================

# Discord bot token - Developer Portal'dan al ve buraya yaz
# https://discord.com/developers/applications
DISCORD_TOKEN=put_your_bot_token_here

# Server (Guild) ID
GUILD_ID=1524635551804686486

# Dashboard API koruma tokeni
DASHBOARD_TOKEN=change-me-secret

# API port
API_PORT=3000

# SQLite veritabani yolu
DATABASE_PATH=data/database.sqlite

# Discord REST islemleri (false = sadece preview, true = gercek islem)
ALLOW_LIVE_DISCORD_ACTIONS=false

# Snapshot modu (true = bot olmadan test icin, false = gercek Discord API)
DEV_USE_SNAPSHOT=true
