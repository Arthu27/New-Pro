# HAKUMO / MOEBIUS BOT — ФАЙЛ КОНФИГУРАЦИИ (.env)
# Скопируйте этот файл в .env и заполните своими ключами.

# ============ 1. ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ DISCORD БОТА ============
# Discord Developer Portal -> Application -> Bot -> Reset/Copy Token
TOKEN=

# Ваш Discord ID пользователя
OWNER_ID=987430047889637426
# Второй/третий владелец бота (через запятую) — им тоже полный доступ
# к панели и командам без проверок. Можно оставить пустым.
OWNER_IDS=

# ── Заявки в команду ──
# Роли, которые бот выдаёт после одобрения (0 = искать по имени «Хелпер»/«Модератор»)
STAFF_HELPER_ROLE_ID=0
STAFF_MODERATOR_ROLE_ID=0
# === Заявки в команду: проще задать в панели, «Каналы и маршруты» (страница
# «Ветки заявок» + секция «Роли заявок»). Ниже — запасной путь, панель главнее.
# Ветки заявок: хелперы и модераторы — отдельные каналы (0 = общий APPLY_CHANNEL_ID)
STAFF_HELPER_CHANNEL_ID=0
STAFF_MODERATOR_CHANNEL_ID=0
# Роли кураторов заявок (помогают команде разбирать заявки)
STAFF_HELPER_CURATOR_ROLE_ID=
STAFF_MODERATOR_CURATOR_ROLE_ID=
# Кого пинговать в ветках заявок — куратор ОДИН на обе ветки (0 = не пинговать)
# Выдаваемые роли после одобрения задаются там же в панели (роль хелпера/модератора)
STAFF_CURATOR_ROLE_ID=0

# Основной сервер бота (slash-команды регистрируются ТОЛЬКО здесь + EXTRA_GUILD_IDS)
MAIN_GUILD_ID=

# Дополнительные серверы для slash-команд (через запятую, если нужно несколько).
# Оставьте пустым, чтобы команды работали только на MAIN_GUILD_ID.
# EXTRA_GUILD_IDS=

# ============ 2. ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ (AI) API КЛЮЧИ ============
# Mistral AI ключ
MISTRAL_API_KEY=

# Альтернативы (используйте если нужно):
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Локальная Ollama (ключ не нужен):
# OLLAMA_URL=http://127.0.0.1:11434
# AI_MODEL=qwen2.5:3b

# ============ 3. НАСТРОЙКИ ВЕБ-ПАНЕЛИ ============
# Порт веб-панели (по умолчанию: 5001)
PORT=5001

# Логин владельца панели (по умолчанию: owner)
PANEL_USER=owner

# Пароль владельца панели. Рекомендуется задать свой!
# Если пусто — при первом запуске сгенерируется случайный надёжный пароль,
# который выводится в консоль и пишется в data/panel_credentials.txt.
# Пароль, изменённый через панель, сохраняется в data/panel_credentials.json
# (только хэш) и имеет приоритет над этим значением.
PANEL_PASSWORD=
# Порт веб-панели (по умолчанию 5001)
# PANEL_PORT=5001

# Как запускается панель (ВАЖНО для связи панели с ботом):
#   пусто/embedded (по умолчанию) — панель в ТОМ ЖЕ процессе, что бот:
#   видит бота, изменения из панели применяются сразу (каналы, коги, синк).
#   gunicorn — отдельный процесс: панель НЕ видит бота («Бот офлайн»),
#   настройки из панели применять нельзя. Не включай без понимания.
# PANEL_PROCESS=embedded

# WebSocket (live-обновления панели): адрес/порт сервера.
# По умолчанию 0.0.0.0:8765 (бот поднимает сам).
# WS_HOST=0.0.0.0
# WS_PORT=8765
# Внешний адрес WebSocket, если панель открыта через домен/туннель и порт
# 8765 проброшен: PANEL_WS_URL=wss://panel.example.com/ws
# PANEL_WS_URL=

# Секретный ключ сессий Flask. Лучше задать свой длинный случайный ключ.
# Если пусто — сгенерируется автоматически и сохранится в data/flask_secret.key
# (НЕ копируйте ключ из примеров — публичный ключ позволяет подделать сессии).
SECRET_KEY=

# Cloudflare Tunnel (1 = открыт, 0 = закрыт)
DISABLE_TUNNEL=0

# ============ РЕЗЕРВНЫЕ КОПИИ (автобэкап data/) ============
# 1 = ежедневный автобэкап включён, 0 = выключен
BACKUP_ENABLED=1
# Час запуска по локальному времени сервера (0-23)
BACKUP_HOUR=5
# Сколько последних архивов хранить (старые удаляются)
BACKUP_KEEP=7
# Папка для архивов
BACKUP_DIR=backups
# 1 = прикладывать архив файлом в мод-лог (только если < 7.5 МБ).
# ВНИМАНИЕ: архив содержит данные сервера — по умолчанию выключено,
# скачивать безопаснее через веб-панель (/backups).
BACKUP_ATTACH=0

# Быстрый вход по токену из URL (?token=...) — ТОЛЬКО для локальной работы!
# ЗА туннелем/прокси все запросы выглядят как 127.0.0.1 → токен = полный доступ.
# 0 = выключено (рекомендуется), 1 = включено (только локально, без туннеля)
ENABLE_TOKEN_LOGIN=0

# ============ 4. ПРОДАКШН ВЕБ-СЕРВЕР (gunicorn) ============
# Количество воркеров (0 = число CPU, max 4)
# WEB_WORKERS=2
# Адрес привязки. Default: 0.0.0.0:5001
# Если панель выходит в сеть ТОЛЬКО через туннель Cloudflare — безопаснее
# биндить локально, чтобы порт не торчал наружу с самого хоста:
# WEB_BIND=127.0.0.1:5001

# Панель за внешним доменом/туннелем (Cloudflare Tunnel → panel.hakumods.xyz):
# честные https:// и хост из X-Forwarded-*. Подробности: docs/PANEL-DOMAIN.md
# WEB_BEHIND_PROXY=1

# Автозапуск Cloudflare-туннеля вместе с ботом (после scripts/setup_panel_tunnel.bat
# работает сам). По умолчанию ВКЛЮЧЁН, когда туннель настроен; 0 — не трогаем туннель.
# TUNNEL_AUTOSTART=1
#
# Протокол named-туннеля до края Cloudflare. Default: http2 (TCP — стабилен).
# cloudflared сам по умолчанию берёт QUIC (UDP), но на части VDS UDP рвётся
# каждые ~20 сек («timeout: no recent network activity») и домен флапает.
# Оставляйте http2; вернуть старое поведение: quic или auto.
# TUNNEL_PROTOCOL=http2
#
# Старый быстрый туннель со случайным адресом (trycloudflare, ссылка менялась
# каждый запуск). ВЫКЛЮЧЕН по умолчанию — у панели постоянный домен.
# Включить обратно только если знаешь зачем:
# QUICK_TUNNEL=1
# Таймаут запроса (секунд). Default: 60
# WEB_TIMEOUT=60
# Уровень логов (debug, info, warning, error). Default: warning
# WEB_LOG_LEVEL=warning
# Keep-alive (секунд). Default: 5
# WEB_KEEPALIVE=5
# Перезапуск воркера после максимума запросов. Default: 1000
# WEB_MAX_REQUESTS=1000

# ============ 5. AI-ПРОВАЙДЕРЫ (дополнительно к п.2) ============
# Кастомный OpenAI-совместимый endpoint и его ключ (если не Mistral/DeepSeek):
# AI_API_URL=
# AI_API_KEY=
# DeepSeek через логин/пароль (резервный способ, ключи надёжнее):
# DEEPSEEK_EMAIL=
# DEEPSEEK_PASSWORD=
# Токен GitHub (для AI через GitHub Models):
# GITHUB_TOKEN=

# ============ 6. ЛОГИРОВАНИЕ ============
# LOG_FILE=data/hakumo.log          # общий файл логов бота
# LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
# LOG_MAX_BYTES=2000000             # ротация: макс. размер файла
# LOG_BACKUP_COUNT=3                # ротация: сколько архивных файлов хранить

# ============ 7. ВЕБ-ПАНЕЛЬ (дополнительно к п.3) ============
# FLASK_SECRET_KEY=                 # альтернативное имя SECRET_KEY (если задан SECRET_KEY — хватит его)
# USE_FS_SESSION=0                  # 1 = сессии на диске (переживают рестарт панели)
# FLASK_SESSION_THRESHOLD=500       # авто-очистка файловых сессий сверх этого числа
# PANEL_URL=                        # внешний адрес панели (для ссылок в уведомлениях/логах)
# PANEL_HTTPS=0                     # 1 = принудительно https во внешних ссылках
# WEB_ACCESS_LOG=-                  # gunicorn access-лог ('-' = stdout, '-' выкл — путь к файлу)
# WEB_ERROR_LOG=-                   # gunicorn error-лог
# WEB_PRELOAD=0                     # 1 = preload приложения (меньше память на воркер)
# WEB_WORKER_CLASS=gthread          # класс воркеров gunicorn

# ============ 8. КАНАЛЫ И РОЛИ ПО УМОЛЧАНИЮ ============
# Обычно НЕ нужно: бот сам создаёт нужные каналы. Только если хотите жёстко
# привязать готовые каналы/роли:
# LOG_CHANNEL_ID=                   # канал мод-логов
# MOD_LOG_CHANNEL_ID=               # альтернативный id канала мод-логов
# APPLY_CHANNEL_ID=                 # канал заявок в стафф
# REQUIRED_ROLE_ID=                 # роль для /apply
# TICKET_CATEGORY_ID=               # категория, куда складывать тикеты
# TICKET_SUPPORT_ROLE_ID=           # роль поддержки тикетов
# TICKET_TRANSCRIPT_CHANNEL_ID=     # канал транскриптов тикетов
# TICKET_MAX_OPEN=3                 # макс. открытых тикетов на юзера

# ============ 9. ПРОЧЕЕ (редко трогают) ============
# BOT_ID=                           # id бота (бот определяет сам; задавать не нужно)
# COMPANION_USER_ID=                # владелец «компаньона»
# DB_PATH=data/bot.db               # путь к SQLite-базе
# ENCRYPTION_KEY=                   # ключ шифрования сервисов (генерируется автоматически)
# VOICE_SECRET=                     # общий секрет голосового веб-интерфейса
# FFMPEG_BINARY=                    # путь к ffmpeg для /play (если нет в PATH)

# ============ 10. РЕЖИМ МОДУЛЕЙ БОТА ============
# ПО УМОЛЧАНИЮ — ЛЁГКИЙ БОЕВОЙ СОСТАВ (LEAN): модерация, защита,
# jail, тикеты (+заявки), музыка, AI-чат и приветствия — около 30 модулей.
# Игры, экономика, уровни, ивенты и прочая «веселуха» СПЯТ: файлы и
# данные на диске остаются, панель честно помечает их страницы чипом «выкл».
# Вернуть всё разом — BOT_FULL=1. Вернуть один модуль — EXTRA_COGS=имя.
# Добровольные профили урезания ниже — включайте ОДИН из них, только
# если хотите ещё более узкого бота.
#
# BOT_FULL=1 — «всё включено» (как раньше): грузятся все ~105 модулей,
# игры и экономика оживают, команды возвращаются в меню бота.
# Переключить режим можно и без правки этого файла — кнопка на странице
# «Команды» панели (пишет data/menu_mode.json, он важнее .env).
BOT_FULL=0
#
# MOD_ONLY=1 — «только модерация»: бот грузит лишь модераторские и системные
# модули (наказания, варны, кейсы, демки, автомод, анти-рейд, анти-альт,
# локдаун, ночной режим, апелляции, мод-дайджест, тикеты, журналы).
# Экономика, игры, МУЗЫКА, AI-чат, ивенты и прочая «веселуха» выключаются:
# команды исчезают из меню, слушатели молчат, страницы панели этих модулей
# помечаются чипом «выкл».
MOD_ONLY=0

# BOT_SLIM=1 — «модерация + тикеты + музыка + AI-чат» (лёгкий профиль):
# грузятся ядро, модерация, тикеты (SLA, набор команды), музыка
# (плеер, голосовые команды, трекер голоса) и AI-чат. Экономика, игры,
# ивенты, левелинг и остальное — выключены, команды исчезают из меню,
# слушатели молчат. Музыка в этом профиле РАБОТАЕТ.
BOT_SLIM=0

# BOT_CORE=1 — «модерация + тикеты + логи + AI» (ядро БЕЗ музыки): грузятся
# системные, модераторские, тикетные, лог- и AI-модули. Экономика, игры,
# музыка, левелинг и прочая «веселуха» выключены. Логи (logs.py, log_menu.py)
# и AI-модерация уже входят в модераторское ядро, AI-чат добавляется отдельно.
BOT_CORE=0

# DEMO_MODE=1 — предпросмотр панели без входа (автовход владельцем, ВЫДУМАННЫЕ
# данные). Только для показа; в боевом запуске держите выключенным.
# Страховка: даже при DEMO_MODE=1 демо игнорируется, если заполнены TOKEN или
# MAIN_GUILD_ID настоящего сервера. Витрина поверх боевого .env: DEMO_FORCE=1.
DEMO_MODE=0

# DOTENV_PATH — читать настройки из другого dotenv-файла вместо этого (.env).
# Нужен только демо-превью панели (start_panel --demo подставляет
# config/panel_preview.env). В боевом запуске НЕ задавайте.
# DOTENV_PATH=

# ============ 11. DISCORD ACTIVITY (музыка в войсе) ============
# Встроенное приложение (Embedded App) — музыкальная панель внутри голосового
# канала. Нужно приложение в Discord Developer Portal с включённой «Embedded
# App», его CLIENT_ID/SECRET и адрес панели. Инструкция: docs/EMBEDDED_APP.md
ACTIVITY_CLIENT_ID=
ACTIVITY_CLIENT_SECRET=
# Куда Discord редиректит OAuth (обычно <адрес панели>/api/activity/music/token)
ACTIVITY_REDIRECT_URI=

# Точечное отключение модулей в ЛЮБОМ режиме (через запятую, без .py):
# DISABLED_COGS=music_cog,giveaway,minigames

# Вернуть отдельные модули поверх MOD_ONLY (через запятую):
# EXTRA_COGS=economy_cog,level_cog
#
# Изменения подхватываются при перезапуске бота. Рантайм без рестарта:
# !module list / !module load music_cog / !module unload giveaway (owner).

# Самообновление бота командой /update (owner): откуда тянуть zip релиза.
# UPDATE_BRANCH можно не писать: демон берёт ТЕКУЩУЮ ветку репозитория.
UPDATE_REPO=Arthu27/New-Pro
# UPDATE_BRANCH=main
# Автоперезапуск демона auto_update.py при новом коммите.
# По умолчанию ВЫКЛЮЧЕНО: демон только поднимает бота, если тот умер.
# Включайте осознанно (AUTO_UPDATE=1) — перезапуск прерывает работу бота.
AUTO_UPDATE=0
# Пауза между автоперезапусками демона (сек, минимум 60, по умолчанию 600).
AUTO_UPDATE_COOLDOWN=600
