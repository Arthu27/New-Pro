# ═══════════════════════════════════════════════════════════════════════════════
#   AETHER / MOEBIUS BOT — ФАЙЛ КОНФИГУРАЦИИ (.env ПРИМЕР ШАБЛОНА)
#   Этот файл '.env' скопируйте как и заполните своими ключами.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ DISCORD БОТА ─────────────────────────────────────────
# Discord Developer Portal -> Application -> Bot -> Reset/Copy Token
TOKEN=

# Ваш Discord ID пользователя (В режиме разработчика кликните правой кнопкой и скопируйте ID)
OWNER_ID=987430047889637426

# Основной сервер бота. Укажите ID сервера, на котором бот сейчас находится.
# Не оставляйте старый ID от другого сервера.
MAIN_GUILD_ID=1498837105915330562


# ─── 2. ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ (AI) API КЛЮЧИ (Опционально) ───────────────────────
# Mistral AI Ключ (https://console.mistral.ai можете получить по адресу)
MISTRAL_API_KEY=

# В качестве альтернативы OpenRouter (https://openrouter.ai/keys) если хотите использовать:
# OPENROUTER_API_KEY=

# В качестве альтернативы OpenAI / DeepSeek если хотите использовать:
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Yerel Ollama если используете (Никакой API ключ не требуется):
# OLLAMA_URL=http://127.0.0.1:11434
# AI_MODEL=qwen2.5:3b


# ─── 3. НАСТРОЙКИ ВЕБ-ПАНЕЛИ ───────────────────────────────────────────────────
# Порт веб-панели (По умолчанию: 5001)
PORT=5001

# Секретный ключ для сессий Flask (Можете написать случайный текст)
SECRET_KEY=aether-super-secret-key-2026

# Cloudflare Tunnel (varsayыlan: 1 = открыт, 0 = закрыт)
# Если cloudflared не установлен или выдаёт ошибку 0 yap
DISABLE_TUNNEL=0

# ── Продакшн веб-сервер (gunicorn) ─────────────────────────────────────────
# Gunicorn количество воркеров (0 = число CPU, max 4). Default: otomatik.
# WEB_WORKERS=2
# Gunicorn адрес привязки. Default: 0.0.0.0:5001
# WEB_BIND=0.0.0.0:5001
# Таймаут запроса (секунд). Default: 60
# WEB_TIMEOUT=60
# Уровень логов (debug, info, warning, error). Default: warning
# WEB_LOG_LEVEL=warning
# Keep-alive (секунд). Default: 5
# WEB_KEEPALIVE=5
# Flask session порог файлов (yuksek tut = меньше дискового IO). Default: 5000
# FLASK_SESSION_THRESHOLD=5000
# Перезапуск воркера после максимума запросов (защита от утечки памяти). Default: 1000
# WEB_MAX_REQUESTS=1000
