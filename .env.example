# ═══════════════════════════════════════════════════════════════════════════════
#   AETHER / MOEBIUS BOT — YAPILANDIRMA DOSYASI (.env ÖRNEK ŞABLONU)
#   Bu dosyayı '.env' olarak kopyalayın ve kendi anahtarlarınızı doldurun.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. ZORUNLU DISCORD BOT AYARLARI ─────────────────────────────────────────
# Discord Developer Portal -> Application -> Bot -> Reset/Copy Token
TOKEN=

# Kendi Discord Kullanıcı ID'niz (Geliştirici modunda sağ tıklayıp ID Kopyala)
OWNER_ID=987430047889637426

# Основной сервер бота. Укажите ID сервера, на котором бот сейчас находится.
# Не оставляйте старый ID от другого сервера.
MAIN_GUILD_ID=1498837105915330562


# ─── 2. YAPAY ZEKA (AI) API ANAHTARLARI (İsteğe Bağlı) ───────────────────────
# Mistral AI Anahtarı (https://console.mistral.ai adresinden alabilirsiniz)
MISTRAL_API_KEY=

# Alternatif olarak OpenRouter (https://openrouter.ai/keys) kullanmak isterseniz:
# OPENROUTER_API_KEY=

# Alternatif olarak OpenAI / DeepSeek kullanmak isterseniz:
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Yerel Ollama kullanıyorsanız (Hiçbir API anahtarı gerekmez):
# OLLAMA_URL=http://127.0.0.1:11434
# AI_MODEL=qwen2.5:3b


# ─── 3. WEB PANEL AYARLARI ───────────────────────────────────────────────────
# Web panel portu (Varsayılan: 5001)
PORT=5001

# Flask oturumları için güvenlik anahtarı (Rastgele metin yazabilirsiniz)
SECRET_KEY=aether-super-secret-key-2026

# ── Production web server (gunicorn) ─────────────────────────────────────────
# Gunicorn worker sayisi (0 = CPU sayisi, max 4). Default: otomatik.
# WEB_WORKERS=2
# Gunicorn bind adresi. Default: 0.0.0.0:5001
# WEB_BIND=0.0.0.0:5001
# Request timeout (saniye). Default: 60
# WEB_TIMEOUT=60
# Log seviyesi (debug, info, warning, error). Default: warning
# WEB_LOG_LEVEL=warning
# Keep-alive (saniye). Default: 5
# WEB_KEEPALIVE=5
# Flask session dosya threshold (yuksek tut = daha az disk IO). Default: 5000
# FLASK_SESSION_THRESHOLD=5000
# Maksimum istek sonrasi worker yenileme (memory leak koruma). Default: 1000
# WEB_MAX_REQUESTS=1000
