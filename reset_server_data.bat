@echo off
chcp 65001 >nul 2>&1
title Hakumo — ПОЛНЫЙ сброс данных серверов
cd /d "%~dp0"

rem ==================================================================
rem  Полный сброс данных: удаляет ВСЮ папку data\ (журналы, варны,
rem  тикеты, XP, балансы, кэш аудита, настройки серверов), логи и
rem  кэш Python. Доступ к панели (логин/пароль) сохраняется.
rem  .env (TOKEN, MAIN_GUILD_ID) НЕ трогается.
rem
rem  ВАЖНО: сначала закрой окно бота — иначе он перезапишет файлы.
rem  Удалить и доступ к панели тоже:  reset_server_data.py --yes
rem ==================================================================

echo ============================================================
echo   HAKUMO — ПОЛНЫЙ СБРОС ДАННЫХ СЕРВЕРОВ
echo   Будет удалено: вся папка data\, логи, кэш Python.
echo   Останется: .env и доступ к панели (логин/пароль).
echo ============================================================
echo.

python --version >nul 2>&1
if errorlevel 1 (
    echo [ОШИБКА] Python не найден — установи с https://python.org
    pause
    exit /b 1
)

tasklist /fi "imagename eq python.exe" 2>nul | find /i "python.exe" >nul
if not errorlevel 1 (
    echo [ВНИМАНИЕ] Обнаружен работающий python.exe — если это бот,
    echo             ЗАКРОЙ его окно сначала, иначе файлы не удалятся
    echo             ^(будут заняты^) и записи появятся снова.
    echo.
)

python reset_server_data.py --yes --keep-auth

echo.
echo ============================================================
echo   Готово. Теперь: запусти бота — данные начнутся с чистого
echo   листа и только по серверу из MAIN_GUILD_ID в .env.
echo ============================================================
pause
