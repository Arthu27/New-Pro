# Демо-превью панели Hakumo — подхватывается ТОЛЬКО при запуске
#   ./start_panel.sh --demo   (или start_panel.bat demo)
# Здесь всё выдуманное: сервер-заглушка, пароль превью. Боевой .env
# сюда не попадает (config.py читает этот файл через DOTENV_PATH).
DEMO_MODE=1
MAIN_GUILD_ID=987654321098765432
SECRET_KEY=local-preview-secret
PANEL_USER=owner
PANEL_PASSWORD=preview123
